{
  "name": "comic-transcriber",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/bundle-inventory.mjs",
    "zip": "wxt zip",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "e2e": "node scripts/e2e.mjs",
    "native:assets": "node scripts/prepare-native.mjs",
    "package": "node scripts/package.mjs",
    "report": "node scripts/report.mjs",
    "storage:report": "node scripts/storage-cleanup.mjs",
    "storage:clean": "node scripts/storage-cleanup.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "onnxruntime-web": "1.30.0",
    "opencc-js": "1.0.5",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.64",
    "@wxt-dev/module-svelte": "2.0.5",
    "fflate": "0.8.3",
    "playwright": "^1.56.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wxt": "0.21.4"
  }
}
